{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raguard.local/schemas/golden_dataset.json",
  "title": "RAGuard golden evaluation dataset",
  "description": "Structural contract for the golden dataset. Validation is deterministic and offline: it proves the dataset is internally consistent and that every case declares an expected behaviour. It cannot prove a case is factually correct against the corpus; that is the job of the keyword-grounding test, which checks every expected keyword against the source documents.",
  "type": "object",
  "required": ["version", "description", "field_documentation", "cases"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Dataset version. Metric runs are only comparable within one version.",
      "minLength": 1
    },
    "description": { "type": "string", "minLength": 1 },
    "field_documentation": { "type": "object" },
    "distribution": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "policy_id": {
      "enum": ["REF-001", "RET-002", "DMG-003", "DEL-004", "PAY-005", "MAN-006"]
    },
    "source_file": {
      "enum": [
        "refund_policy.txt",
        "return_policy.txt",
        "damaged_product_policy.txt",
        "delivery_policy.txt",
        "payment_failure_faq.txt",
        "product_manual_example.txt"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "ground_truth",
        "expected_sources",
        "expected_policy_ids",
        "expected_keywords",
        "should_abstain",
        "expected_outcome",
        "case_type",
        "category",
        "priority",
        "difficulty",
        "probes",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^GC-[0-9]{3}$",
          "description": "Stable identifier, never reused."
        },
        "question": { "type": "string", "minLength": 3 },
        "ground_truth": {
          "type": "string",
          "minLength": 3,
          "description": "Reference answer, grounded in the corpus. Not consulted by the deterministic tier."
        },
        "expected_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_file" },
          "uniqueItems": true
        },
        "expected_policy_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/policy_id" },
          "uniqueItems": true
        },
        "expected_chunk_indices": {
          "type": "array",
          "description": "Verified chunk positions holding the answer. Chunk indices are stable per source under a fixed chunking configuration; chunk database IDs are not, so indices are used instead.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "chunk_index"],
            "properties": {
              "source": { "$ref": "#/$defs/source_file" },
              "chunk_index": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "expected_keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Literal strings that must survive retrieval. Each is verified to occur in at least one expected source."
        },
        "should_abstain": {
          "type": "boolean",
          "description": "Retained for compatibility with the Phase B and Phase C evaluators, which exclude these cases from retrieval aggregates. Must agree with expected_outcome."
        },
        "expected_outcome": {
          "enum": ["answer", "clarify", "abstain", "escalate"]
        },
        "case_type": {
          "enum": [
            "normal",
            "paraphrase",
            "exact_term",
            "multi_policy",
            "ambiguous",
            "unanswerable",
            "prompt_injection",
            "high_risk"
          ]
        },
        "category": {
          "enum": [
            "refund",
            "return",
            "damaged",
            "delivery",
            "payment",
            "product_manual",
            "multi_policy",
            "out_of_scope",
            "security"
          ]
        },
        "priority": { "enum": ["critical", "high", "medium", "low"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "probes": { "type": "string", "minLength": 3 },
        "notes": { "type": "string", "minLength": 3 },
        "paraphrase_of": {
          "type": "string",
          "pattern": "^GC-[0-9]{3}$",
          "description": "The case this one restates in different words."
        },
        "injection_must_not": {
          "type": "array",
          "items": {
            "enum": [
              "override_system_behaviour",
              "force_unsupported_answer",
              "reveal_system_prompt",
              "bypass_evidence_requirement"
            ]
          },
          "uniqueItems": true,
          "description": "Behaviours a prompt-injection case must never produce."
        }
      },
      "allOf": [
        {
          "description": "Abstention cases cite nothing, because nothing in the corpus answers them.",
          "if": { "properties": { "expected_outcome": { "const": "abstain" } } },
          "then": {
            "properties": {
              "should_abstain": { "const": true },
              "expected_sources": { "maxItems": 0 },
              "expected_policy_ids": { "maxItems": 0 },
              "expected_keywords": { "maxItems": 0 }
            }
          }
        },
        {
          "description": "Answerable and escalating cases must name the evidence that supports them.",
          "if": {
            "properties": {
              "expected_outcome": { "enum": ["answer", "escalate", "clarify"] }
            }
          },
          "then": {
            "properties": {
              "should_abstain": { "const": false },
              "expected_sources": { "minItems": 1 },
              "expected_policy_ids": { "minItems": 1 }
            }
          }
        },
        {
          "description": "A multi-policy case is only multi-policy if it needs more than one document. This is what makes Recall@k measure something HitRate@k does not.",
          "if": { "properties": { "case_type": { "const": "multi_policy" } } },
          "then": {
            "properties": {
              "expected_sources": { "minItems": 2 },
              "expected_policy_ids": { "minItems": 2 }
            }
          }
        },
        {
          "description": "Injection cases must declare what they are testing against.",
          "if": { "properties": { "case_type": { "const": "prompt_injection" } } },
          "then": { "required": ["injection_must_not"] }
        },
        {
          "description": "A paraphrase must say what it paraphrases.",
          "if": { "properties": { "case_type": { "const": "paraphrase" } } },
          "then": { "required": ["paraphrase_of"] }
        }
      ]
    }
  }
}
