{
  "name": "RAGuard Cloud Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteEnv": {
    "RAGUARD_CODESPACES_DATA_DIR": "${containerWorkspaceFolder}/.codespaces"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8000,
    8501
  ],
  "portsAttributes": {
    "8000": {
      "label": "RAGuard API",
      "onAutoForward": "silent",
      "visibility": "private"
    },
    "8501": {
      "label": "RAGuard Frontend",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  }
}
