# ---------------------------------------------------------------------------
# RAGuard environment template. Copy to `.env` and fill in real values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# development | test | production. Production enables strict startup checks.
RAGUARD_ENVIRONMENT=development

# --- Database (pgvector) ---
DATABASE_URL=postgresql://raguard:raguard@localhost:5433/raguard
# Optional direct/admin URL for CREATE EXTENSION and schema DDL. Leave empty
# when DATABASE_URL is already a direct connection. Never commit its password.
DATABASE_ADMIN_URL=
VECTOR_DIMENSION=1024
# A request waits at most this long for a pooled connection. The pool keeps
# reconnecting in the background for DB_RECONNECT_TIMEOUT_S.
DB_POOL_TIMEOUT_S=10
DB_CONNECT_TIMEOUT_S=10
DB_RECONNECT_TIMEOUT_S=30
# For native Windows mode without Docker, replace DATABASE_URL with the direct
# connection URL of your managed PostgreSQL database after it has pgvector
# enabled. Do not commit its password.

# --- LLM provider: gemini | groq | openrouter | ollama ---
LLM_PROVIDER=gemini
# static preserves LLM_PROVIDER-only behavior. dynamic chooses one provider at
# graph start: normal RAG prefers Gemini; strict/evaluation prefers Groq.
LLM_ROUTING_MODE=static
# Dynamic mode only. Keep true for local/private/offline execution; no hosted
# provider is selected or used as a fallback in this mode.
LLM_ROUTING_LOCAL_ONLY=false
# Dynamic mode only. Start strict structured-output workloads on Groq when its
# key is configured. Evaluation always has this preference in dynamic mode.
LLM_ROUTING_STRICT_STRUCTURED_OUTPUT=false
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Generation model used for answers and query rewriting.
# VERIFIED 2026-08-16 against a live key: `gemini-2.5-flash` and
# `gemini-2.5-flash-lite` return 404 "no longer available to new users", and
# `gemini-flash-latest` resolves to a model capped at 5 requests/minute on the
# free tier. Pinned rather than `-latest` so evaluation runs stay comparable.
GEMINI_MODEL=gemini-3.1-flash-lite
# Evidence grader and citation-entailment judge. Intentionally a DIFFERENT model
# from the generator: a judge sharing the generator's weights shares its blind
# spots, and independent verification is the point of the citation layer.
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
# Optional hosted Groq provider. `openai/gpt-oss-20b` supports strict native
# JSON schemas, which RAGuard uses for answers, grades, rewrites, and judges.
# Leave GROQ_API_KEY empty unless selecting Groq statically or enabling a
# dynamic strict/evaluation route.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# Optional OpenRouter fallback. It is selected only in dynamic routing after
# Gemini and Groq fail; an API key alone does not change static selection.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Bounded exponential-backoff retries for standalone Groq calls. An active
# graph passes zero retries so its provider-call budget remains exact.
GROQ_MAX_RETRIES=2
# Provider-agnostic override for the generator. LEAVE EMPTY to use the selected
# provider's configured generator model; a stale value here silently overrides it.
# With LLM_PROVIDER=ollama set this to a locally pulled tag, e.g. llama3.2:3b.
LLM_MODEL=
# 0.0 keeps answer generation reproducible; the rewriter adds its own offset.
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_REQUEST_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Used only when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings and reranking ---
# local downloads BGE-M3; gemini uses the hosted Gemini embedding API and
# automatically disables the local reranker. Re-ingest after changing this.
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# full | local_compact. `full` is the production/evaluation default;
# local_compact selects RERANKER_FALLBACK_MODEL while retaining BGE-M3.
RAGUARD_RUNTIME_PROFILE=full
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Loaded only if the primary reranker cannot be loaded. 22 M parameters,
# so it stays usable where the 568 M primary is not.
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# cpu | cuda | mps
MODEL_DEVICE=cpu
# auto selects CUDA when PyTorch exposes an NVIDIA GPU, otherwise CPU. Set
# cpu or cuda:0 explicitly only to override auto-detection.
RERANKER_DEVICE=auto

# Explicit reranker provider. `local` is the private/offline default. There is
# intentionally no `auto`: an API key alone must never send policy chunks out.
RERANKER_PROVIDER=local
RERANKER_REMOTE_ALLOWED=false
# Required only when RERANKER_PROVIDER=voyage and remote use is explicitly allowed.
# Keep this in a secret manager; never commit a populated .env file.
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2.5-lite
HOSTED_RERANK_TIMEOUT_SECONDS=3
HOSTED_RERANK_MAX_RETRIES=1
HOSTED_RERANK_TOP_K=5
HOSTED_RERANK_MAX_CANDIDATES=20
# On hosted timeout, 429, temporary outage, or malformed response: local | rrf.
RERANKER_FALLBACK_PROVIDER=local
# `unverified` keeps hosted relevance scores out of BGE confidence thresholds.
# Set a named provider profile only after the live calibration evaluation passes.
RERANKER_CONFIDENCE_PROFILE=unverified

# Native launcher cache location. `scripts/run-native.ps1` sets these values
# for its own process so model files do not default to %USERPROFILE% on C:.
# HF_HOME=.cache/raguard-models

# --- Ingestion ---
DATA_DIR=data/policies
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Evaluation ---
# Point this at a larger dataset to evaluate without changing code.
GOLDEN_DATASET_PATH=src/evaluation/golden_dataset.json

# --- Retrieval ---
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_K=20
RERANK_TOP_K=5
RRF_K=60

# --- Reranking ---
# Disabling this returns the RRF order; it does not break retrieval.
RERANKER_ENABLED=true
# Candidates scored by the cross-encoder. Cost is linear in this number.
RERANK_CANDIDATE_TOP_K=20
# 0 auto-selects 32 on CUDA and 16 on CPU; set a positive value only after a
# benchmark on this deployment's model, candidate count, and available memory.
RERANKER_BATCH_SIZE=0
RERANKER_MAX_LENGTH=512
# Serialize model inference by default to avoid CUDA OOM and CPU thread
# oversubscription under concurrent API queries. It never changes rankings.
RERANKER_MAX_CONCURRENCY=1
# 0 leaves PyTorch's CPU thread setting unchanged. Tune only from benchmark data.
RERANKER_CPU_THREADS=0
# Run one synthetic pair during background model warm-up, not on the first query.
RERANKER_WARMUP_INFERENCE=true

# --- Deduplication ---
DEDUP_ENABLED=true
DEDUP_NEAR_DUPLICATE_THRESHOLD=0.90
DEDUP_ADJACENT_THRESHOLD=0.70
# Maximum consecutive chunks from a single source; 0 disables the cap.
DEDUP_MAX_ADJACENT_RUN=5

# --- Self-healing thresholds ---
# Normalised reranker score below which retrieval is treated as weak.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
# Normalised reranker score below which the system abstains outright.
ABSTAIN_THRESHOLD=0.30
MAX_HEALING_ATTEMPTS=2
QUERY_REWRITE_VARIANTS=3
# Minimum lexical overlap between an answer sentence and its cited chunk.
CITATION_SUPPORT_THRESHOLD=0.25
# One deadline and one provider-call allowance span grading, rewrites,
# generation, per-claim entailment, and regeneration. The graph timeout must be
# lower than both API_TIMEOUT_S and ADMISSION_LEASE_SECONDS.
GRAPH_REQUEST_TIMEOUT_S=150
GRAPH_LLM_CALL_LIMIT=8
# baseline preserves the evaluated eight-call graph. Set free_hosted_pilot to
# cap one graph at four provider calls for a quota-constrained pilot; evaluate
# it separately before using it because budget exhaustion abstains.
LLM_EXECUTION_PROFILE=baseline

# --- Frontend ---
# Streamlit reads API_BASE_URL from the API section below. Inside Docker
# Compose it is overridden to http://api:8000.
API_TIMEOUT_S=180

# --- API ---
# Comma-separated browser origins allowed to call the API. Not "*": the
# default covers a local Streamlit only. Widen deliberately, never by default.
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Required for POST /retrieve and /admin/*; leave blank only when those
# endpoints should be disabled.
ADMIN_API_KEY=
# Per-process safety valve. Enforce equivalent limits at the API gateway in a
# multi-instance deployment.
QUERY_MAX_CONCURRENCY=4
QUERY_RATE_LIMIT_PER_MINUTE=30
# `local` is suitable only for one API process. Use `redis` for production
# replicas; a Redis outage fails closed rather than bypassing the guard.
ADMISSION_BACKEND=local
ADMISSION_REDIS_URL=redis://localhost:6379/0
ADMISSION_REDIS_NAMESPACE=raguard:admission
ADMISSION_LEASE_SECONDS=300
# Optional OTLP/HTTP endpoint for traces. Leave empty to keep trace context
# local; query text, sources, prompts, and credentials are never traced.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=raguard-api
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
