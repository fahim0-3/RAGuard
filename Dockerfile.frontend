# Streamlit UI only. Deliberately separate from the API image: the frontend
# needs neither PyTorch nor the ~2.5 GB of model weights, and building it from
# the API image would drag both in for a process that only speaks HTTP.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8501 \
    HEALTHCHECK_PATH=/_stcore/health

WORKDIR /app

# Only what the UI actually imports.
RUN pip install --upgrade pip && pip install "streamlit>=1.32.0" "httpx>=0.27"

COPY frontend/ ./frontend/
COPY scripts/container_healthcheck.py ./scripts/container_healthcheck.py

RUN addgroup --system --gid 10001 raguard \
    && adduser --system --uid 10001 --ingroup raguard --home /home/raguard raguard \
    && chown -R raguard:raguard /app /home/raguard

USER 10001:10001

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-m", "scripts.container_healthcheck"]

CMD ["sh", "-c", "exec streamlit run frontend/app.py --server.address=0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
